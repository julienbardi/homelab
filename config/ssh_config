# ssh_config
# ============================================================
# GLOBAL HARDENED DEFAULTS (portable across Windows/Linux/macOS)
# ============================================================
Host *
    # Identity
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

    # Multiplexing (Linux/macOS use it; Windows ignores safely)
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m

    # Safety & ergonomics
    ServerAliveInterval 30
    ServerAliveCountMax 3
    StrictHostKeyChecking yes
    UserKnownHostsFile ~/.ssh/known_hosts


# ============================================================
# ROUTER — Asus RT-AX86U Pro
# ============================================================
Host router
    HostName 10.89.12.1
    Port 2222
    User julie


# ============================================================
# DISKSTATION — Synology DS218play
# ============================================================
Host diskstation
    HostName 10.89.12.2
    Port 2222
    User julie


# ============================================================
# QNAP — TS210 (legacy OpenSSH)
# ============================================================
Host qnap
    HostName 10.89.12.3
    Port 2222
    User admin


# ============================================================
# NAS — Ugreen DXP4800+
# Requires PQ-KEX suppression
# ============================================================
Host nas
    HostName 10.89.12.4
    Port 2222
    User julie
    KexAlgorithms -sntrup761x25519-sha512@openssh.com


# ============================================================
# ACCESS POINT — Asus RT-AC86U
# ============================================================
Host ac86u
    HostName 10.89.12.6
    Port 2222
    User admin

# ============================================================
# HUB01 — Cryptomator Hub VM
# ============================================================
Host hub01
    HostName 10.89.12.11
    Port 22
    User julie

