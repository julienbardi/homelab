# ------------------------------------------------------------
# SAFETY:
# This Caddyfile MUST NOT bind to :80.
# Port 443 is explicitly managed here.
# ------------------------------------------------------------

{
	auto_https off
	# PVE loopback is fully reliable; restrict admin API to localhost for security
	admin 127.0.0.1:2019
}

# Syncthing GUI
bardi.ch:8384 {
	reverse_proxy 10.89.12.2:8384
}

# Consolidated HTTPS listener
:443 {
	tls /etc/ssl/caddy/bardi.ch.cer /etc/ssl/caddy/bardi.ch.key

	# --- Audit-Required Security Headers ---
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# --- NetBird Robust Rate Limiting ---
	rate_limit {
		# Restrict sensitive API, OIDC, and management endpoints strictly
		zone netbird_api_zone {
			match {
				path /api/* /oauth2/* /signalexchange.SignalExchange/* /management.ManagementService/* /management.ProxyService/* /relay/* /ws-proxy/*
			}
			key {http.request.remote.host}
			events 60
			window 1m
		}

		# General dashboard UI limit for non-API web assets
		zone netbird_ui_zone {
			match {
				host netbird.bardi.ch
			}
			key {http.request.remote.host}
			events 250
			window 1m
		}
	}

	# NetBird Management API & gRPC (h2c)
	@netbird_api {
		host netbird.bardi.ch
		path /api/* /signalexchange.SignalExchange/* /management.ManagementService/* /management.ProxyService/* /relay/* /ws-proxy/* /oauth2/*
	}
	reverse_proxy @netbird_api 10.89.12.4:10080 {
		transport http {
			versions h2c 2
		}
	}

	# NetBird Dashboard UI (Catch-all for netbird.bardi.ch)
	@netbird_ui {
		host netbird.bardi.ch
	}
	reverse_proxy @netbird_ui 10.89.12.4:10081

	# DNS over HTTPS (public)
	@doh {
		host dns.bardi.ch
		path /dns-query
	}
	reverse_proxy @doh https://10.89.12.4:8053 {
		transport http {
			tls
			tls_insecure_skip_verify
		}

		# --- DoH health checks ---
		health_uri /dns-query?name=example.com&type=A
		health_interval 10s
		health_timeout 2s
		fail_duration 30s
	}

	# DiskStation main HTTPS site (WAN)
	@bardi_internal {
		host bardi.ch
	}
	reverse_proxy @bardi_internal https://10.89.12.2:443 {
		header_up Host bardi.ch
		transport http {
			tls_insecure_skip_verify
		}
	}

	# DSM management (internal only)
	@syno5001_internal {
		host bardi.ch
		remote_ip 10.89.12.0/24
		remote_ip fd89:7a3b:42c0::/64
	}
	reverse_proxy @syno5001_internal https://10.89.12.2:5001 {
		header_up Host bardi.ch
		transport http {
			tls_insecure_skip_verify
		}
	}

	# Synology service (internal only)
	@syno5006_internal {
		host bardi.ch
		remote_ip 10.89.12.0/24
		remote_ip fd89:7a3b:42c0::/64
	}
	reverse_proxy @syno5006_internal https://10.89.12.2:5006 {
		header_up Host bardi.ch
		transport http {
			tls_insecure_skip_verify
		}
	}

	# Synology Drive (internal only)
	@syno6690_internal {
		host bardi.ch
		remote_ip 10.89.12.0/24
		remote_ip fd89:7a3b:42c0::/64
	}
	reverse_proxy @syno6690_internal https://10.89.12.2:6690 {
		header_up Host bardi.ch
		transport http {
			tls_insecure_skip_verify
		}
	}

	# Headscale control plane (external clients allowed)
	@vpn {
		host vpn.bardi.ch
	}
	reverse_proxy @vpn 10.89.12.4:8910 {
		header_up Host vpn.bardi.ch
		header_up X-Forwarded-Proto https
	}

	# DERP relay (external)
	@derp host derp.bardi.ch
	reverse_proxy @derp 10.89.12.4:8912

	# QNAP (internal only)
	@qnap_internal {
		host qnap.bardi.ch
		remote_ip 10.89.12.0/24
		remote_ip fd89:7a3b:42c0::/64
	}
	reverse_proxy @qnap_internal 10.89.12.3:8080

	# NAS internal service (internal only)
	@nas_internal {
		host nas.bardi.ch
		remote_ip 10.89.12.0/24
		remote_ip fd89:7a3b:42c0::/64
	}
	reverse_proxy @nas_internal 10.89.12.4:9999

	# Router (internal only)
	@router_internal {
		host router.bardi.ch
		remote_ip 10.89.12.0/24
		remote_ip fd89:7a3b:42c0::/64
	}
	reverse_proxy @router_internal 10.89.12.1:8080

	# Dev IDE (internal only)
	@dev_internal {
		host dev.bardi.ch
		remote_ip 10.89.12.0/24
		remote_ip fd89:7a3b:42c0::/64
		remote_ip 10.0.0.0/8
		remote_ip fd89:7a3b:42c0::/48
		remote_ip 100.64.0.0/10
	}
	reverse_proxy @dev_internal 10.89.12.4:8080 {
		header_up Host dev.bardi.ch
	}

	# Proxmox VE (internal / VPN only)
	@pve_internal {
		host pve.bardi.ch
		remote_ip 10.89.12.0/24
		remote_ip fd89:7a3b:42c0::/64
		remote_ip 10.0.0.0/8
		remote_ip fd89:7a3b:42c0::/48
		remote_ip 100.64.0.0/10
	}
	reverse_proxy @pve_internal https://10.89.12.4:8006 {
		header_up Host pve.bardi.ch
		transport http {
			tls_insecure_skip_verify
		}
	}

	# apt-cacher-ng (internal only)
	@apt_internal {
		host apt.bardi.ch
		remote_ip 10.89.12.0/24
		remote_ip fd89:7a3b:42c0::/64
		remote_ip 10.0.0.0/8
		remote_ip fd89:7a3b:42c0::/48
		remote_ip 100.64.0.0/10
	}

	handle @apt_internal {
		reverse_proxy 10.89.12.4:3142 {
			header_up Host apt.bardi.ch
			health_uri /acng-report.html
			health_interval 10s
			health_timeout 2s
			fail_duration 30s
		}
		respond "APT cache temporarily unavailable" 503
	}

	# Unknown host fallback
	@unknown not host \
		bardi.ch \
		router.bardi.ch \
		dns.bardi.ch \
		vpn.bardi.ch \
		derp.bardi.ch \
		qnap.bardi.ch \
		nas.bardi.ch \
		dev.bardi.ch \
		apt.bardi.ch \
		netbird.bardi.ch \
		pve.bardi.ch

	respond @unknown "Not Found" 404
}