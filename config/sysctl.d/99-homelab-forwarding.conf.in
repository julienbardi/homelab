# config/sysctl.d/99-homelab-forwarding.conf
# -------------------------------------------------------------------------
# SOURCE: homelab repo (installed via 'make install-homelab-sysctl')
# -------------------------------------------------------------------------
# MANDATORY FOR: WireGuard, Tailscale, and LAN-to-WAN routing.
# This file enforces the IPv6 stack at the kernel level to resolve the
# "Ghost IP" discrepancy between UGOS GUI and the Linux CLI.

# --- IPv4 Forwarding ---
# Enables the NAS to route IPv4 traffic between wgN and the physical LAN.
net.ipv4.ip_forward = 1

# --- IPv6 Forwarding ---
# Required for Symmetric GUA/ULA WireGuard contract (Option B).
# Specifically enables routing for the physical interface (${NAS_LAN_IFACE}).
net.ipv6.conf.all.forwarding = 1
net.ipv6.conf.default.forwarding = 1
net.ipv6.conf.${NAS_LAN_IFACE}.forwarding = 1

# --- IPv6 Router Advertisements Acceptance ---
# INVARIANT: Setting net.ipv6.conf.all.forwarding = 1 (above) forces
# accept_ra = 0 on ALL interfaces by default (Linux kernel behavior).
# Without this overrides the NAS loses the IPv6 default route it learns
# via RA from the router, and wg7 clients tunnelling IPv6 traffic hit a
# silent black hole.
# Value 2 = "accepts RAs even when forwarding is enabled" (TFC 4861 §6.2.3).
# Only ${NAS_LAN_IFACE} (LAN) should receive RAs; wgN interfaces never do.
net.ipv6.conf.${NAS_LAN_IFACE}.accept_ra = 2

# --- IPv6 Stack Enforcement ---
# Force-enables the IPv6 stack.
# Must be '0' for the ULA (fd89:7a3b:42c0::4) to be visible to the kernel.
net.ipv6.conf.all.disable_ipv6 = 0
net.ipv6.conf.default.disable_ipv6 = 0
net.ipv6.conf.lo.disable_ipv6 = 0
