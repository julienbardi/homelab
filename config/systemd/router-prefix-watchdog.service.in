[Unit]
Description=Watch for router IPv6 prefix changes and trigger converge
After=network-online.target

[Service]
Type=simple
User=$(ROOT_UID)
Group=$(ROOT_GID)
Environment=REPO_ROOT=${REPO_ROOT}
ExecStart=${INSTALL_PATH}/homelab-router-prefix-watchdog.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
