-- dnsdist.conf: DNS frontend for homelab (Proxmox VE)
-- ------------------------------------------------------------
-- Role:
--   - dnsdist is the primary DNS frontend on Proxmox VE
--   - dnsdist listens on port 53 (UDP+TCP) & DoH port
-- ------------------------------------------------------------

local cert = "${DNSDIST_CERT}"
local key  = "${DNSDIST_KEY}"

-- ------------------------------------------------------------
-- DoH & DoH3 listeners (Public & Local)
-- ------------------------------------------------------------
local doh_endpoints = {
   "127.0.0.1:${DOH_PORT}",
   "[::1]:${DOH_PORT}",
   "${DNSDIST_LAN_IP}:${DOH_PORT}",
   "[${DNSDIST_ULA_IP}]:${DOH_PORT}"
}

for _, ep in ipairs(doh_endpoints) do
   addDOHLocal(ep, cert, key, { "/dns-query" })
   pcall(addDOH3Local, ep, cert, key, { "/dns-query" })
end

-- ------------------------------------------------------------
-- Plain DNS listeners (UDP+TCP port 53)
-- ------------------------------------------------------------
addLocal("127.0.0.1:53")
addLocal("${DNSDIST_LAN_IP}:53")
addLocal("[::1]:53")
addLocal("[${DNSDIST_ULA_IP}]:53")

-- ------------------------------------------------------------
-- Backend: Unbound (loopback, recursive)
-- ------------------------------------------------------------
newServer({ address = "127.0.0.1:${UNBOUND_PORT}", name = "unbound", checkType = "none" })

setServerPolicy(firstAvailable)

-- ------------------------------------------------------------
-- Packet Cache: Instant responses for repeat queries
-- ------------------------------------------------------------
pc = newPacketCache(10000, {maxTTL=86400, minTTL=60, staleTTL=60})
getPool(""):setCache(pc)

-- ------------------------------------------------------------
-- ACL: Allow public testing probers alongside internal networks
-- ------------------------------------------------------------
setACL({
  "127.0.0.0/8",
  "::1/128",
  "10.0.0.0/8",
  "${LAN_SUBNET}",
  "${ULA_PREFIX}",
  "0.0.0.0/0",
  "::/0"
})

-- ------------------------------------------------------------
-- Performance & Safety Limits
-- ------------------------------------------------------------
setMaxUDPOutstanding(4096)
setMaxTCPClientThreads(200)