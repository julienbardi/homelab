# ssh_config (generated from config.mk)
# ============================================================
# GLOBAL HARDENED DEFAULTS (portable across Linux/macOS/Windows)
# ============================================================
Host *
    IdentityFile ${SSH_IDENTITY_FILE}
    IdentitiesOnly yes

    # Multiplexing (Linux/macOS use it; Windows ignores safely)
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m

    # Safety & ergonomics
    ServerAliveInterval 30
    ServerAliveCountMax 3
    StrictHostKeyChecking ${SSH_STRICT}
    UserKnownHostsFile ~/.ssh/known_hosts

    # Modern ciphers
    Ciphers aes128-ctr,aes192-ctr,aes256-ctr,aes128-gcm@openssh.com,aes256-gcm@openssh.com,chacha20-poly1305@openssh.com


# ============================================================
# ROUTER — Asus RT-AX86U Pro
# ============================================================
Host router
    HostName ${LAN_ROUTER}
    Port ${SSH_PORT_ROUTER}
    User ${SSH_USER_ROUTER}

# IP fallback (required because some systems resolve "router" via /etc/hosts")
Host ${LAN_ROUTER}
    User ${SSH_USER_ROUTER}
    Port ${SSH_PORT_ROUTER}


# ============================================================
# DISKSTATION — Synology DS218play (legacy SSH)
# ============================================================
Host diskstation
    HostName ${LAN_SYNOLOGY}
    Port ${SSH_PORT_SYNOLOGY}
    User ${SSH_USER_SYNOLOGY}

Host ${LAN_SYNOLOGY}
    Port ${SSH_PORT_SYNOLOGY}
    User ${SSH_USER_SYNOLOGY}

    # Synology DS218play requires legacy algorithms
    KexAlgorithms +diffie-hellman-group14-sha1
    Ciphers +aes128-ctr,aes256-ctr
    MACs +hmac-sha2-256,hmac-sha1


# ============================================================
# QNAP — TS210 (legacy OpenSSH)
# ============================================================
Host qnap
    HostName ${LAN_QNAP}
    Port 2222
    User ${SSH_USER_QNAP}

Host ${LAN_QNAP}
    Port 2222
    User ${SSH_USER_QNAP}

# ============================================================
# NAS — Ugreen DXP4800+ (PQ-KEX suppression) running PVE — Proxmox VE (operator + root)
# ============================================================
Host nas
    HostName ${LAN_NAS}
    Port ${NAS_SSH_PORT}
    User root
    KexAlgorithms -sntrup761x25519-sha512@openssh.com

Host pve
    HostName ${LAN_NAS}
    Port ${NAS_SSH_PORT}
    User root
    KexAlgorithms -sntrup761x25519-sha512@openssh.com

Host ${LAN_NAS}
    Port ${NAS_SSH_PORT}
    User root
    KexAlgorithms -sntrup761x25519-sha512@openssh.com

Host pve-root
    HostName ${LAN_NAS}
    Port ${NAS_SSH_PORT}
    User root
    KexAlgorithms -sntrup761x25519-sha512@openssh.com

Host pve-julie
    HostName ${LAN_NAS}
    Port ${NAS_SSH_PORT}
    User ${SSH_USER_NAS}
    KexAlgorithms -sntrup761x25519-sha512@openssh.com

# ============================================================
# ACCESS POINT — Asus RT-AC86U
# ============================================================
Host ac86u
