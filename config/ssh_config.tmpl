    Port ${SSH_PORT_AC86U}
    User ${SSH_USER_AC86U}

Host ${LAN_AC86U}
    Port ${SSH_PORT_AC86U}
    User ${SSH_USER_AC86U}

# ============================================================
# HUB01 — Cryptomator Hub VM
# ============================================================
Host hub01
    HostName ${LAN_HUB01}
    Port ${SSH_PORT_DEFAULT}
    User ${SSH_USER_HUB01}

Host ${LAN_HUB01}
    Port ${SSH_PORT_DEFAULT}
    User ${SSH_USER_HUB01}