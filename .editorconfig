root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[Makefile]
indent_style = tab
tab_width = 4

[mk/*.mk]
indent_style = tab
tab_width = 4

[*.sh]
indent_style = space
indent_size = 4

# YAML (including Docker Compose)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[Caddyfile]
indent_style = space
indent_size = 4

[*.caddy]
indent_style = space
indent_size = 4

[Dockerfile]
indent_style = space
indent_size = 4

[Dockerfile.*]
indent_style = space
indent_size = 4

[*.Dockerfile]
indent_style = space
indent_size = 4
