# Combined NetBird Server Configuration (Simplified)
# Generated by getting-started.sh

server:
  listenAddress: ":80"
  exposedAddress: "https://netbird.bardi.ch:443"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "__NB_AUTH_SECRET__"
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://netbird.bardi.ch/oauth2"
    clientID: "netbird-dashboard"
    audience: "netbird"
    signKeyRefreshEnabled: true
    dashboardRedirectURIs:
      - "https://netbird.bardi.ch/nb-auth"
      - "https://netbird.bardi.ch/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "172.30.0.10/32"

  store:
    engine: "sqlite"
    encryptionKey: "__NB_ENCRYPTION_KEY__"
