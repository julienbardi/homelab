#!/bin/sh
# /jffs/scripts/wan-event
set -eu

# --- Merlin wan-event arguments ---
EVENT_STAGE="${2:-}"

# Only run on full WAN connect
if [ "$EVENT_STAGE" != "connected" ] && [ -n "$EVENT_STAGE" ]; then
    exit 0
fi

# --- IPv6 prerequisites (must run BEFORE RA/DHCPv6) ---
echo 2 > /proc/sys/net/ipv6/conf/all/accept_ra
echo 2 > /proc/sys/net/ipv6/conf/eth0/accept_ra

echo 1 > /proc/sys/net/ipv6/conf/all/forwarding
echo 1 > /proc/sys/net/ipv6/conf/br0/forwarding
echo 1 > /proc/sys/net/ipv6/conf/eth0/forwarding

# --- Ensure IPv4 default route exists (self-healing) ---
if ! ip route show default | grep -q ' dev eth0'; then
    GW="$(nvram get wan0_gateway || true)"
    if [ -n "$GW" ]; then
        ip route replace default via "$GW" dev eth0 || true
    fi
fi

# --- Logging & state ---
LOG="/jffs/prefix-change.log"
PREFIX_STATE="/jffs/prefix-current"

NAS="julie@10.89.12.4"
NAS_STAMP="/tank/julie/src/homelab/.state/stamps/router-prefix.last"
NAS_MARKER="/tank/julie/src/homelab/.state/stamps/router-prefix.changed"

# --- Extract LAN-advertised GUA from br0 (wait for convergence) ---
RAW_GUA=""
for i in 1 2 3 4 5; do
    RAW_GUA=$(ip -6 addr show dev br0 scope global \
        | awk '/inet6/ {print $2}' | cut -d/ -f1 | head -n1)
    [ -n "$RAW_GUA" ] && break
    sleep 1
done

if [ -z "$RAW_GUA" ]; then
    echo "$(date) ERROR: No global IPv6 found on br0" >> "$LOG"
    exit 0
fi

# --- Derive delegated /64 prefix (first 4 hextets) ---
PREFIX=$(printf '%s\n' "$RAW_GUA" \
    | sed -E 's/^((([0-9a-f]{1,4}:){3}[0-9a-f]{1,4})).*/\1::\/64/')

# Validate prefix
case "$PREFIX" in
    ""|*::*::*|*[!0-9a-fA-F:/]*)
        echo "$(date) ERROR: Invalid prefix derived from $RAW_GUA" >> "$LOG"
        exit 0
        ;;
esac

CHANGED=0

if [ ! -f "$PREFIX_STATE" ]; then
    echo "$PREFIX" > "$PREFIX_STATE"
    CHANGED=1
    echo "$(date) INIT PREFIX=$PREFIX" >> "$LOG"
else
    OLD_PREFIX=$(cat "$PREFIX_STATE")

    if [ "$OLD_PREFIX" != "$PREFIX" ]; then
        echo "$(date) PREFIX CHANGE old=$OLD_PREFIX new=$PREFIX" >> "$LOG"
        echo "$PREFIX" > "$PREFIX_STATE"
        CHANGED=1
	else
        echo "$(date) PREFIX UNCHANGED $PREFIX" >> "$LOG"
    fi
fi

# --- Send prefix to NAS + notify converge ---
if [ "$CHANGED" -eq 1 ]; then
    echo "$PREFIX" | ssh \
        -i /jffs/.ssh/id_ed25519 \
        -o BatchMode=yes \
        -p 22 \
        "$NAS" \
        "cat > '$NAS_STAMP'"

    ssh \
        -i /jffs/.ssh/id_ed25519 \
        -o BatchMode=yes \
        -p 22 \
        "$NAS" \
        "touch '$NAS_MARKER'"
fi
