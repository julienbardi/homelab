#!/bin/sh
# Ensure IPv6 RA acceptance is correct BEFORE dhcp6c and RA processing
echo 2 > /proc/sys/net/ipv6/conf/all/accept_ra
echo 2 > /proc/sys/net/ipv6/conf/eth0/accept_ra

# Ensure IPv6 forwarding is correct BEFORE routing engine initializes
echo 1 > /proc/sys/net/ipv6/conf/all/forwarding
echo 1 > /proc/sys/net/ipv6/conf/br0/forwarding
echo 1 > /proc/sys/net/ipv6/conf/eth0/forwarding

# Detect IPv6 prefix change and notify NAS (router-side)
PREFIX_STATE="/jffs/prefix-current"
LOG="/jffs/prefix-change.log"

NAS=julie@10.89.12.4
NAS_MARKER="/var/lib/homelab/router-prefix.changed"
NAS_STAMP="/var/lib/homelab/router-prefix.last"

# Extract delegated prefix (normalized)
CUR=$(ip -6 addr show dev eth0 \
    | awk '/scope global/ {print $2}' \
    | cut -d/ -f1 \
    | sed 's/:[0-9a-fA-F]\{1,4\}$/::/' \
    | sed 's/::\+$/::/' \
    | head -n1)

# Ignore empty or bogus prefixes
case "$CUR" in
    ""|*::*::*) exit 0 ;;
esac

# Validate prefix is a sane hex:colon string before embedding in SSH commands
case "$CUR" in
    *[!0-9a-fA-F:]*) exit 0 ;;
esac

# Initialize state file if missing
if [ ! -f "$PREFIX_STATE" ]; then
    echo "$CUR" > "$PREFIX_STATE"
    echo "$(date) INIT prefix=$CUR" >> "$LOG"

    # Initialize NAS stamp + marker
    ssh -p 2222 "$NAS" "echo '$CUR' > '$NAS_STAMP'; touch '$NAS_MARKER'"
    exit 0
fi

OLD=$(cat "$PREFIX_STATE")

# Compare prefixes
if [ "$CUR" != "$OLD" ]; then
    echo "$(date) PREFIX CHANGE old=$OLD new=$CUR" >> "$LOG"
    echo "$CUR" > "$PREFIX_STATE"

    # Notify NAS with updated stamp + marker
    ssh -p 2222 "$NAS" "echo '$CUR' > '$NAS_STAMP'; touch '$NAS_MARKER'"
fi
