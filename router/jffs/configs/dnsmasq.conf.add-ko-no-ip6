# --- PART A: LOCAL SOVEREIGNTY ---
# Define the authoritative domain for the LAN
domain=bardi.ch
# Do not forward queries for this domain to upstream servers
local=/bardi.ch/
# Allow shortnames (e.g., 'nas') to resolve as 'nas.bardi.ch'
expand-hosts

# --- PART B: HIGH-PERFORMANCE SOVEREIGNTY ---
# Favor the NAS (Unbound) via the low-latency IPv4 path
server=10.89.12.4

# Advertise NAS (primary) and router (fallback) as DNS to DHCP clients
dhcp-option=6,10.89.12.4,10.89.12.1

# --- PART C: GRACEFUL DEGRADATION ---
all-servers

# --- PART D: HYGIENE & SECURITY ---
domain-needed
bogus-priv

# --- PART E: IPv6 Router Advertisements (LAN only) ---
# ============================================================
# Dual-stack LAN policy:
# - Stable ULA for internal sovereignty.
# - Global prefix from br0 (attached by dhcp6c-state) for Internet reachability.
# ============================================================

# Enable Router Advertisements
enable-ra

# 1) ULA-only range (unchanged behavior)
dhcp-range=set:ula,fd89:7a3b:42c0::100,fd89:7a3b:42c0::1ff,ra-names,64,86400s
dhcp-option=tag:ula,option6:dns-server,[fd89:7a3b:42c0::4],[fd89:7a3b:42c0::1]

# 2) Global prefix range from whatever is on br0
#    Your dhcp6c-state script will ensure br0 always has exactly one GUA prefix.
dhcp-range=set:gua,::,constructor:br0,ra-names,86400
dhcp-option=tag:gua,option6:dns-server,[fd89:7a3b:42c0::4],[fd89:7a3b:42c0::1]

# RA parameters:
# - Prefix length 64 (required for SLAAC)
# - RA lifetime 1800s
ra-param=br0,64,1800
