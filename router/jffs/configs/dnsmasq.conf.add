# /jffs/configs/dnsmasq.conf.add
# Authored, version-controlled, and validated by homelab automation — DO NOT EDIT ON ROUTER
# ============================================================
# DNSMASQ CUSTOM CONFIGURATION
# ============================================================
# Role:
#   • Router = authoritative DNS server for LAN + WG (IPv4 + IPv6)
#   • NAS Unbound = backend recursive resolver (DNSSEC, DoT)
#   • Parallel query with public fallbacks enabled via all-servers
# ============================================================

# --- PART A: LOCAL SOVEREIGNTY ------------------------------
domain=lan.bardi.ch
local=/lan.bardi.ch/
expand-hosts
localise-queries

# Static infrastructure overrides
address=/router.lan.bardi.ch/10.89.12.1
address=/router.lan.bardi.ch/fd89:7a3b:42c0::1
ptr-record=10.89.12.1,router.lan.bardi.ch
ptr-record=fd89:7a3b:42c0::1,router.lan.bardi.ch

address=/diskstation.lan.bardi.ch/10.89.12.2
address=/diskstation.lan.bardi.ch/fd89:7a3b:42c0::2
ptr-record=10.89.12.2,diskstation.lan.bardi.ch
ptr-record=fd89:7a3b:42c0::2,diskstation.lan.bardi.ch

address=/qnap.lan.bardi.ch/10.89.12.3
address=/qnap.lan.bardi.ch/fd89:7a3b:42c0::3
ptr-record=10.89.12.3,qnap.lan.bardi.ch
ptr-record=fd89:7a3b:42c0::3,qnap.lan.bardi.ch

address=/pve.lan.bardi.ch/10.89.12.4
address=/pve.lan.bardi.ch/fd89:7a3b:42c0::4
ptr-record=10.89.12.4,pve.lan.bardi.ch
ptr-record=fd89:7a3b:42c0::4,pve.lan.bardi.ch

address=/raspberrypi.lan.bardi.ch/10.89.12.5
address=/raspberrypi.lan.bardi.ch/fd89:7a3b:42c0::5
ptr-record=10.89.12.5,raspberrypi.lan.bardi.ch
ptr-record=fd89:7a3b:42c0::5,raspberrypi.lan.bardi.ch

# --- PART B: UPSTREAM RESOLVER SELECTION ---------------------
# Primary local Unbound (IPv4 + IPv6)
server=10.89.12.4#15335
server=fd89:7a3b:42c0::4#15335

# Parallel public fallback resolvers (IPv4 & IPv6)
# 1) CH Quad9
server=/#/9.9.9.9
server=/#/2620:fe::fe
# 2) CH Switch
server=/#/130.59.31.248
server=/#/2001:620:0:ff::2
# 3) CH Digitale Gesellschaft
server=/#/185.95.218.42
server=/#/2a05:fc84::42

# DHCPv4 DNS option pointing to router
dhcp-option=6,10.89.12.1

# Announce router ULA address as the DNS server for DHCPv6 clients
dhcp-option=option6:dns-server,[fd89:7a3b:42c0::1]

# Set the DNS suffix for DHCP clients (Windows primary DNS suffix)
dhcp-option=15,lan.bardi.ch

# --- PART C: GRACEFUL DEGRADATION ---------------------------
# Query all upstream servers concurrently and take the first response
# (Removed all-servers to prioritize local NAS caching)
all-servers

# --- PART D: HYGIENE & SECURITY -----------------------------
domain-needed
bogus-priv

# --- PART E: IPv6 Router Advertisements (LAN only) -----------
# Note: RA configuration is handled natively by AsusWRT to prevent service crashes.
