# /jffs/configs/dnsmasq.conf.add
# Generated by homelab automation - DO NOT EDIT MANUALLY
# ============================================================
# DNSMASQ CUSTOM CONFIGURATION — FINAL ARCHITECTURE
# ============================================================
# Role:
#   • Router = authoritative DNS server for LAN + WG (IPv4 + IPv6)
#   • NAS Unbound = backend recursive resolver (DNSSEC, DoT upstream)
#   • dnsdist = IPv6 DNS frontend for WG IPv6 clients (port 53 only)
#
# Guarantees:
#   1. All LAN/WG clients resolve via router → Unbound
#   2. No recursion on router (forward‑only)
#   3. No DNSSEC on router (Unbound handles it)
#   4. No fallback to ISP unless Unbound is unreachable
#   5. Stable ULA‑only IPv6 addressing (no global prefix leakage)
# ============================================================


# --- PART A: LOCAL SOVEREIGNTY ----------------------------------------------
# Define the authoritative domain for the LAN
domain=lan.bardi.ch

# Do not forward queries for this domain to upstream servers
local=/lan.bardi.ch/

# Allow shortnames (e.g., 'nas') to resolve as 'nas.bardi.ch'
expand-hosts

# Static router hostname (LAN + WG)
address=/router.lan.bardi.ch/10.89.12.1
address=/router.bardi.ch/10.89.12.1
# Optional IPv6:
address=/router.lan.bardi.ch/fd89:7a3b:42c0::1
address=/router.bardi.ch/fd89:7a3b:42c0::1

# --- PART B: UPSTREAM RESOLVER SELECTION -------------------------------------
# Forward ALL external DNS queries to Unbound on the NAS
# IPv4 path (primary)
server=10.89.12.4#15335

# IPv6 path (secondary), dnsmasq does not support bracketed IPv6 addresses in server= directives.
server=fd89:7a3b:42c0::4#15335

# Advertise router as DNS server to DHCPv4 clients
# (router = 10.89.12.1)
dhcp-option=6,10.89.12.1

# Router advertises itself as DNS for IPv6 clients via RA/DHCPv6 below


# --- PART C: GRACEFUL DEGRADATION -------------------------------------------
# If Unbound is down, dnsmasq will fall back to ISP DNS
# (this is safe and intentional)
all-servers


# --- PART D: HYGIENE & SECURITY ---------------------------------------------
domain-needed
bogus-priv


# --- PART E: IPv6 Router Advertisements (LAN only) ---------------------------
# ULA‑ONLY RA POLICY
# ------------------------------------------------------------
# Why this matters:
# 1. AsusWRT sometimes reassigns the WAN‑delegated global prefix to br0.
#    If dnsmasq sees a global prefix on br0, it may *re‑advertise it*.
# 2. Clients then keep a stale global IPv6 address even after the router
#    stops routing that prefix → IPv6 breaks silently.
# 3. Using "constructor:br0" is dangerous because it mirrors whatever
#    prefixes appear on br0 (including accidental global ones).
# 4. Explicit ULA prefix ensures LAN IPv6 is *stable*, *predictable*,
#    and *never depends on WAN state*.
# 5. This eliminates the exact failure mode you previously experienced.
# ------------------------------------------------------------
# DISABLED: conflicts with AsusWRT auto‑generated RA block (double enable-ra/ra-param kills dnsmasq)

# Enable Router Advertisements
#enable-ra

# Explicit ULA-only prefix (NO constructor, NO global prefix leakage)
#dhcp-range=set:ula,fd89:7a3b:42c0::100,fd89:7a3b:42c0::1ff,ra-names,64,86400s

# Advertise router as IPv6 DNS server
# (router = fd89:7a3b:42c0::1)
#dhcp-option=tag:ula,option6:dns-server,[fd89:7a3b:42c0::1]

# RA parameters:
# - Prefix length 64 (required for SLAAC)
# - RA lifetime 1800s (clients refresh often, stale prefixes die quickly)
# - Prevents clients from caching old global prefixes indefinitely
#ra-param=br0,64,1800

# --- PART F: HOMELAB NODE IDENTITY -------------------------------------------

# Proxmox node pve1 (LAN IPv4 + ULA IPv6)
address=/pve1.bardi.ch/10.89.12.4
address=/pve1.bardi.ch/fd89:7a3b:42c0::4

